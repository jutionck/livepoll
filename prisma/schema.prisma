generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  code                      String   @id @db.VarChar(10)
  title                     String   @db.VarChar(255)
  status                    String   @default("active") @db.VarChar(20)
  activeQuestionId          String?  @map("active_question_id") @db.VarChar(50)
  activeQuestionActivatedAt Int?     @map("active_question_activated_at")
  hostTokenHash             String   @map("host_token_hash") @db.VarChar(255)
  hostIdHash                String?  @map("host_id_hash") @db.VarChar(255)
  hostAccountId             String?  @map("host_account_id") @db.Uuid
  hostName                  String?  @map("host_name") @db.VarChar(100)
  hostOrg                   String?  @map("host_org") @db.VarChar(150)
  version                   Int      @default(1)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt                 DateTime @map("expires_at") @db.Timestamptz(6)

  questions Question[]
  votes     Vote[]
  joinedParticipants JoinedParticipant[]
  hostAccount HostAccount? @relation(fields: [hostAccountId], references: [id], onDelete: SetNull)

  @@map("sessions")
}

model HostAccount {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  authTokenHash String?  @map("auth_token_hash") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("host_accounts")
}

model JoinedParticipant {
  id              String   @id @default(uuid()) @db.Uuid
  sessionCode     String   @map("session_code") @db.VarChar(10)
  participantId   String   @map("participant_id") @db.VarChar(100)
  participantName String?  @map("participant_name") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionCode], references: [code], onDelete: Cascade)

  @@unique([sessionCode, participantId])
  @@map("joined_participants")
}

model Question {
  id            String   @id @default(uuid()) @db.Uuid
  sessionCode   String   @map("session_code") @db.VarChar(10)
  qId           String   @map("q_id") @db.VarChar(50)
  type          String   @db.VarChar(50)
  title         String   @db.Text
  options       Json     @default("{}")
  timer         Int?
  correctAnswer Json?    @map("correct_answer")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionCode], references: [code], onDelete: Cascade)

  @@unique([sessionCode, qId])
  @@map("questions")
}

model Vote {
  id              String   @id @default(uuid()) @db.Uuid
  sessionCode     String   @map("session_code") @db.VarChar(10)
  questionId      String   @map("question_id") @db.VarChar(50)
  participantId   String   @map("participant_id") @db.VarChar(100)
  participantName String?  @map("participant_name") @db.VarChar(100)
  vote            Json
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionCode], references: [code], onDelete: Cascade)

  @@unique([sessionCode, questionId, participantId])
  @@index([sessionCode, questionId])
  @@map("votes")
}

model Testimonial {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  role      String   @db.VarChar(150)
  message   String   @db.Text
  rating    Int      @default(5) @db.SmallInt
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("testimonials")
}
