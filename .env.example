# PostgreSQL Connection String
# Local development: postgres://localhost/livepoll
# Supabase (recommended for Vercel): use Transaction Pooler (port 6543)
#   Format: postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Passwords with special characters (@, ?, etc.) are auto-encoded by the app.
DATABASE_URL="postgresql://username:password@hostname:5432/databasename"

# Prisma CLI migration (Supabase Session Pooler, port 5432)
# Used when running: npx prisma migrate deploy
# MIGRATE_DATABASE_URL="postgresql://username:password@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Vercel Cron Secret (Optional, for automatic cleanup endpoint)
CRON_SECRET="your_vercel_cron_secret"

# Admin Panel Password (for managing testimonials)
ADMIN_PASSWORD="your-admin-password"

# Vercel Web Analytics API (Optional, for the traffic KPI card in /admin)
# 1. Enable Web Analytics for this project in the Vercel dashboard.
# 2. Create an access token: https://vercel.com/account/tokens
# 3. Find your projectId in Project Settings > General.
# 4. teamId is only needed for team-owned projects (omit for personal account projects).
VERCEL_TOKEN="your-vercel-access-token"
VERCEL_PROJECT_ID="prj_xxxxxxxxxxxxxxxxxxxxxxxx"
# VERCEL_TEAM_ID="team_xxxxxxxxxxxxxxxxxxxxxxxx"
